{
  "name": "bp-translator",
  "version": "1.0.4",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "webpack --mode development && electron .",
    "dev": "concurrently \"webpack --watch --mode development\" \"wait-on dist/bundle.js && cross-env NODE_ENV=development electron .\"",
    "setup:ocr": "pip install -r python/requirements.txt",
    "build": "node scripts/build.mjs"
  },
  "keywords": [],
  "author": "sh1shn",
  "license": "ISC",
  "description": "Japanese manga translator desktop app",
  "build": {
    "appId": "com.sh1shn.traductor",
    "productName": "BP Translator",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "crop.html",
      "src/Utils/**/*",
      "src/Scripts/**/*",
      "src/Constants/**/*",
      "dist/**/*",
      "public/**/*",
      "assets/**/*",
      "python/**/*",
      "!**/.env"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/bPants/burguerico.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/bPants/burguerico.ico",
      "uninstallerIcon": "assets/bPants/burguerico.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BP Translator",
      "artifactName": "bp-translator-Setup.exe"
    },
    "portable": {
      "artifactName": "bp-translator-portable.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "electron-store": "^10.1.0",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@electron/packager": "^20.0.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "style-loader": "^4.0.0",
    "wait-on": "^9.0.10",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "ajv": "^8.20.0",
    "@develar/schema-utils": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    },
    "fast-uri": "^3.1.2",
    "node-forge": "^1.4.0",
    "path-to-regexp": "0.1.13",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.14",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "ws": "^8.20.1"
  }
}
